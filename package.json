{
  "name": "club-platform",
  "private": true,
  "packageManager": "bun@1.2.23",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:changed": "bun scripts/lint-changed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "bun --env-file=.env scripts/seed.ts",
    "import:legacy:dry-run": "bun --env-file=.env scripts/import-legacy-data.ts",
    "import:legacy": "bun --env-file=.env scripts/import-legacy-data.ts --commit",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.9",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0"
  }
}
